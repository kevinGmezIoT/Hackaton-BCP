# Servidor de Vigía. En una misma laptop reservar un puerto distinto al del puente.
VIGIA_HOST=127.0.0.1
VIGIA_PORT=8001

# Puente del equipo de UI. Completar URL (http://IP:puerto) y token para activar.
VIGIA_BRIDGE_URL=
VIGIA_BRIDGE_TOKEN=
VIGIA_BRIDGE_EVENTS_PATH=/api/ingesta/eventos
VIGIA_BRIDGE_DECISION_PATH=/api/casos/{caso}/decision
VIGIA_BRIDGE_METRICS_PATH=/api/ingesta/metricas
VIGIA_BRIDGE_HEALTH_PATH=/api/salud
VIGIA_BRIDGE_CHAT_PATH=/chat
VIGIA_BRIDGE_INVESTIGATE_PATH=/investigar
VIGIA_BRIDGE_ACTOR=operador-puente

# Rutas del servidor del agente. Vacías seleccionan los datos de demostración.
# El catálogo contiene el path Draw.io y los identificadores de repositorio por servicio.
VIGIA_FIXTURES_DIR=
VIGIA_CATALOG_PATH=
VIGIA_METRICS_PATH=
VIGIA_LOGS_PATH=
VIGIA_RELEASES_PATH=
VIGIA_INCIDENTS_PATH=
VIGIA_RUNBOOKS_DIR=
VIGIA_LOCAL_REPOS=
VIGIA_DB_PATH=
VIGIA_AUDIT_PATH=

# Orígenes externos, si se usan en vez de archivos.
VIGIA_PROMETHEUS_URL=
VIGIA_LOKI_URL=
VIGIA_METRICS_API_URL=
VIGIA_LOGS_API_URL=
VIGIA_GITHUB_API_URL=
VIGIA_GITHUB_REPOS=
VIGIA_GITHUB_TOKEN=
VIGIA_TELEMETRY_TOKEN=
VIGIA_WEBHOOK_TOKEN=
